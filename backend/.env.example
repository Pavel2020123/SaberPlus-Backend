# Conexion usada por NestJS en ejecucion. En Supabase debe ser la URL del
# Session pooler (puerto 5432) o la conexion directa si el host admite IPv6.
DATABASE_URL=
# Conexion usada exclusivamente por Prisma CLI para migraciones y tareas
# administrativas. Nunca se expone a Flutter ni se guarda en Git.
DIRECT_URL=
JWT_SECRET=
# C3-D1: las nuevas escrituras de estado están desactivadas por defecto.
# NO activar en staging/producción antes de unificar rutas heredadas (C3-D2).
EDITORIAL_PUBLICATION_ENABLED=false
# Secreto estable para generar alias privados del ranking. Usa un valor distinto
# de JWT_SECRET en producción y no lo cambies salvo que quieras rotar los alias.
RANKING_ALIAS_SECRET=
FRONTEND_URL=http://localhost:3001
# Lista opcional de origenes web separados por coma. Las apps Android/iOS no
# dependen de CORS, pero los paneles web si.
ALLOWED_ORIGINS=http://localhost:3001
PORT=3000
NODE_ENV=development

# Credenciales de ePayco. Nunca publiques EPAYCO_P_KEY en el frontend.
EPAYCO_PUBLIC_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_TEST_MODE=true

# Indexación administrativa por lotes; no publica ni reclasifica preguntas.
# Activar temporalmente solo después de respaldo y autorización del entorno.
EDITORIAL_LEGACY_INDEX_ENABLED=false
# Reclasificación revisada de preguntas sin uso registrado, dentro de su área.
# No activar hasta verificar PostgreSQL y autorizar el entorno de ensayo.
EDITORIAL_RECLASSIFICATION_ENABLED=false

# Correo transaccional.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
VENTAS_NOTIFICACION_CORREO=

# Activa solo cuando la API esté detrás de un proxy confiable.
TRUST_PROXY=false

# Limite conservador para no agotar las conexiones del plan de Supabase.
# Se agrega como query param `connection_limit` a DATABASE_URL; no se usa como
# variable independiente por Prisma 5.
