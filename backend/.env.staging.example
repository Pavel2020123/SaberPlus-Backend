# Copia este archivo como `.env.staging.local` y reemplaza los valores.
# El archivo `.local` esta ignorado por Git.

# Backend persistente sobre una red IPv4: usa Supavisor Session pooler (5432).
# Agrega sslmode=require y limita las conexiones de Prisma en staging.
DATABASE_URL="postgresql://prisma.PROJECT_REF:URL_ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20"

# Migraciones: usa la conexion directa si el equipo tiene IPv6. Si no la tiene,
# Supabase permite usar temporalmente el Session pooler del puerto 5432.
DIRECT_URL="postgresql://prisma:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

JWT_SECRET="GENERA_UN_SECRETO_ALEATORIO_LARGO"
RANKING_ALIAS_SECRET="GENERA_OTRO_SECRETO_ALEATORIO_DISTINTO"
FRONTEND_URL="https://staging.saberplus.example"
ALLOWED_ORIGINS="https://staging.saberplus.example"
PORT=3000
NODE_ENV=production
TRUST_PROXY=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
VENTAS_NOTIFICACION_CORREO=
